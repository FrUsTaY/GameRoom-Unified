# Game-Room Web & Sync Server Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit .env with real credentials to git!

# --- Web Authentication (Mandatory) ---
# Generate password hash using: python generate_hash.py
GAME_ROOM_WEB_USERNAME=your_username
GAME_ROOM_WEB_PASSWORD_HASH=your_argon2id_hash_here

# --- Android Sync Token (Optional Override) ---
# If left empty, a secure 32-byte token is auto-generated in SQLite on first launch.
# GAMEROOM_SYNC_TOKEN=your_custom_sync_token

# --- Server Port & Storage ---
PORT=8080
BACKLOG_DB_PATH=/app/data/backlog.db
TZ=Europe/Moscow
